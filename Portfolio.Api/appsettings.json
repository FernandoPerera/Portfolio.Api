{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "portfolio-api",
    "Audience": "portfolio-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "AuthorizeEndpoint": "https://github.com/login/oauth/authorize",
    "TokenEndpoint": "https://github.com/login/oauth/access_token",
    "UserEndpoint": "https://api.github.com/user",
    "UserAgent": "Portfolio.Api"
  },
  "Auth": {
    "FrontendRedirectUri": ""
  },
  "Admin": {
    "Username": "",
    "GitHubUserId": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Public": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "localhost"
}
